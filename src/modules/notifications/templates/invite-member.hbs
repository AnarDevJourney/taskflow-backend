<html>
  <head>
    <meta charset='utf-8' />
    <style>
      body {
        font-family: Arial, sans-serif;
        color: #1f2937;
      }
      .header {
        background: #2563eb;
        padding: 24px 32px;
      }
      .header h1 {
        color: #fff;
        margin: 0;
        font-size: 20px;
      }
      .body {
        padding: 32px;
      }
      .workspace-box {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        padding: 20px;
        margin: 16px 0;
        text-align: center;
      }
      .role-badge {
        display: inline-block;
        background: #dbeafe;
        color: #1d4ed8;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        margin-top: 6px;
      }
      .btn {
        display: inline-block;
        background: #2563eb;
        color: #fff;
        text-decoration: none;
        padding: 12px 28px;
        border-radius: 6px;
        font-weight: 600;
        margin-top: 16px;
      }
      .footer {
        padding: 16px 32px;
        font-size: 12px;
        color: #9ca3af;
        border-top: 1px solid #e5e7eb;
      }
    </style>
  </head>
  <body>
    <div class='header'><h1>TaskFlow</h1></div>
    <div class='body'>
      <p>Hi there,</p>
      <p><strong>{{inviterName}}</strong>
        has invited you to join their workspace on TaskFlow:</p>
      <div class='workspace-box'>
        <div
          style='font-weight:700;font-size:18px;color:#1E40AF'
        >{{workspaceName}}</div>
        <div><span class='role-badge'>{{role}}</span></div>
      </div>
      <div style='text-align:center'>
        <a href='{{inviteUrl}}' class='btn'>Accept Invitation</a>
        <div style='font-size:12px;color:#9CA3AF;margin-top:12px'>This
          invitation expires in 72 hours.</div>
      </div>
    </div>
    <div class='footer'>If you weren't expecting this invitation, you can safely
      ignore this email.</div>
  </body>
</html>