<html>
  <head>
    <meta charset='utf-8' />
    <style>
      body {
        font-family: Arial, sans-serif;
        color: #1f2937;
      }
      .header {
        background: #2563eb;
        padding: 24px 32px;
      }
      .header h1 {
        color: #fff;
        margin: 0;
        font-size: 20px;
      }
      .body {
        padding: 32px;
      }
      .btn {
        display: inline-block;
        background: #2563eb;
        color: #fff;
        text-decoration: none;
        padding: 12px 28px;
        border-radius: 6px;
        font-weight: 600;
        margin-top: 16px;
      }
      .footer {
        padding: 16px 32px;
        font-size: 12px;
        color: #9ca3af;
        border-top: 1px solid #e5e7eb;
      }
    </style>
  </head>
  <body>
    <div class='header'><h1>TaskFlow</h1></div>
    <div class='body'>
      <p>{{greeting}}</p>
      <p>{{intro}}</p>
      <div style='text-align:center'>
        <a href='{{resetUrl}}' class='btn'>{{buttonLabel}}</a>
        <div style='font-size:12px;color:#9CA3AF;margin-top:12px'>{{expiryNote}}</div>
      </div>
    </div>
    <div class='footer'>{{footerNote}}</div>
  </body>
</html>
