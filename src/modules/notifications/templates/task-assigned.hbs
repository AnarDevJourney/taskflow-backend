<html>
  <head>
    <meta charset='utf-8' />
    <style>
      body {
        font-family: Arial, sans-serif;
        color: #1f2937;
      }
      .header {
        background: #2563eb;
        padding: 24px 32px;
      }
      .header h1 {
        color: #fff;
        margin: 0;
        font-size: 20px;
      }
      .body {
        padding: 32px;
      }
      .task-box {
        background: #f3f4f6;
        border-radius: 6px;
        padding: 16px;
        margin: 16px 0;
      }
      .btn {
        display: inline-block;
        background: #2563eb;
        color: #fff;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        margin-top: 16px;
      }
      .footer {
        padding: 16px 32px;
        font-size: 12px;
        color: #9ca3af;
        border-top: 1px solid #e5e7eb;
      }
    </style>
  </head>
  <body>
    <div class='header'><h1>TaskFlow</h1></div>
    <div class='body'>
      <p>Hi {{recipientName}},</p>
      <p><strong>{{actorName}}</strong>
        assigned you a task in
        <strong>{{projectName}}</strong>:</p>
      <div class='task-box'>
        <strong>{{taskKey}} — {{taskTitle}}</strong><br />
        <span style='color:#6B7280;font-size:13px'>Priority:
          {{priority}}
          · Due:
          {{dueDate}}</span>
      </div>
      <a href='{{taskUrl}}' class='btn'>View Task</a>
    </div>
    <div class='footer'>You're receiving this because you have task assignment
      notifications enabled.
      <a href='{{prefsUrl}}'>Manage preferences</a></div>
  </body>
</html>